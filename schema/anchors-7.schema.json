{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stc:anchors-7",
  "title": "stc session anchors, v7",
  "description": "anchors-6 plus `geometry` (STC-235): the refit timeline, present only when the display changed mid-take and the take continued.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "timebase",
    "t0Ns",
    "display",
    "capture",
    "files"
  ],
  "$defs": {
    "display": {
      "description": "The display the take happened on — for a region or window scope, the display the region/window was resolved against, in the SAME shape a whole-display take already carries. A region's own rectangle lives in `scope.region`, display-local points against this block's originX/originY, exactly like shot.json's crop.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pointWidth",
        "pointHeight",
        "pixelWidth",
        "pixelHeight",
        "backingScale",
        "originX",
        "originY"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "pointWidth": {
          "type": "integer",
          "minimum": 1
        },
        "pointHeight": {
          "type": "integer",
          "minimum": 1
        },
        "pixelWidth": {
          "type": "integer",
          "minimum": 1
        },
        "pixelHeight": {
          "type": "integer",
          "minimum": 1
        },
        "backingScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "originX": {
          "type": "number",
          "description": "global display-space origin of the captured display, in points (CGEvent coordinates are global)"
        },
        "originY": {
          "type": "number"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 7
    },
    "timebase": {
      "description": "mach_timebase_info at helper startup. displayTimeNs = displayTime * numer / denom.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numer",
        "denom"
      ],
      "properties": {
        "numer": {
          "type": "integer",
          "minimum": 1
        },
        "denom": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "t0Ns": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "codec"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2160
        },
        "codec": {
          "enum": [
            "h264"
          ]
        },
        "firstFrameNs": {
          "type": "integer",
          "minimum": 0,
          "description": "Session-relative ns of the first captured frame, measured by the helper. The file carries the same offset only as an empty edit quantised to the movie timescale, so this is the exact value to check a recovered offset against."
        }
      }
    },
    "camera": {
      "description": "Absent means no camera track was even attempted. present:false means a camera was attempted (or considered) but yielded no track — measurement fields are meaningless then and must be omitted, not fabricated. Only present:true requires them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "device": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "firstFramePtsNs": {
          "type": "integer",
          "minimum": 0
        },
        "lastFramePtsNs": {
          "type": "integer",
          "minimum": 0
        },
        "frameIntervalNs": {
          "type": "integer",
          "minimum": 1,
          "description": "median inter-frame delta; the transform bounds the track end with it"
        }
      },
      "if": {
        "properties": {
          "present": {
            "const": true
          }
        },
        "required": [
          "present"
        ]
      },
      "then": {
        "required": [
          "present",
          "device",
          "width",
          "height",
          "firstFramePtsNs",
          "lastFramePtsNs",
          "frameIntervalNs"
        ],
        "properties": {
          "present": {
            "type": "boolean"
          },
          "device": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "firstFramePtsNs": {
            "type": "integer",
            "minimum": 0
          },
          "lastFramePtsNs": {
            "type": "integer",
            "minimum": 0
          },
          "frameIntervalNs": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "mic": {
      "description": "STC-233. Absent means no mic was even requested — a picker with nothing chosen. present:false means a device WAS named but yielded no track (not found, failed to open, or opened and delivered nothing); measurement fields are meaningless then and must be omitted, not fabricated. Only present:true requires them. Mirrors camera's own present/requested split (STC-303) exactly, and the same reason: camera==nil is ambiguous between 'never asked' and 'asked, got nothing', and mic==nil would be too.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "device": {
          "type": "string"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "firstFramePtsNs": {
          "type": "integer",
          "minimum": 0
        },
        "lastFramePtsNs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "present": {
            "const": true
          }
        },
        "required": [
          "present"
        ]
      },
      "then": {
        "required": [
          "present",
          "device",
          "sampleRate",
          "channels",
          "firstFramePtsNs",
          "lastFramePtsNs"
        ],
        "properties": {
          "present": {
            "type": "boolean"
          },
          "device": {
            "type": "string"
          },
          "sampleRate": {
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "type": "integer",
            "minimum": 1
          },
          "firstFramePtsNs": {
            "type": "integer",
            "minimum": 0
          },
          "lastFramePtsNs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "system": {
      "description": "STC-418. Absent means system audio was not requested (the toggle was off). present:false means it WAS requested but yielded no track (the stream delivered no audio sample at all, or the writer refused it); measurement fields are meaningless then and must be omitted, not fabricated. Only present:true requires them. The same present/requested split mic (STC-233) and camera (STC-303) already make, for the same reason. No `device`: there is exactly one system output to capture, and it is the whole machine's whatever the take's scope — a window-scoped take still records every app's audio (Patrick, 2026-09-24).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "firstFramePtsNs": {
          "type": "integer",
          "minimum": 0
        },
        "lastFramePtsNs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "present": {
            "const": true
          }
        },
        "required": [
          "present"
        ]
      },
      "then": {
        "required": [
          "present",
          "sampleRate",
          "channels",
          "firstFramePtsNs",
          "lastFramePtsNs"
        ],
        "properties": {
          "present": {
            "type": "boolean"
          },
          "sampleRate": {
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "type": "integer",
            "minimum": 1
          },
          "firstFramePtsNs": {
            "type": "integer",
            "minimum": 0
          },
          "lastFramePtsNs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "scope": {
      "description": "What this take is scoped to, when it is not the whole display (STC-370). Absent means display — the same 'no scope block' a v2 document has, but v3+ documents may still write it explicitly. Mirrors shot-1's kind/crop/window shapes so a still and a take describe the same thing the same way.",
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "display"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "region"
          ],
          "properties": {
            "kind": {
              "const": "region"
            },
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "description": "display-local points, against this document's own display.originX/originY — the same convention shot-1's crop uses."
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "window"
          ],
          "properties": {
            "kind": {
              "const": "window"
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "bounds"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "app": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "bounds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pauses": {
      "description": "Spans the take was paused (STC-240). Session-relative ns, half-open [startNs, endNs), disjoint and ascending. Absent when the take was never paused — such a take stays at version 4.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startNs",
          "endNs"
        ],
        "properties": {
          "startNs": {
            "type": "integer",
            "minimum": 0
          },
          "endNs": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "geometry": {
      "description": "STC-235. Present only after at least one refit. Entry 0 is the take's start (top-level display, full-frame contentRect, startNs = capture.firstFrameNs). contentRect is in capture pixels. Selected by the PTS of the frame being shown.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startNs", "display", "contentRect"],
        "properties": {
          "startNs": { "type": "integer", "minimum": 0 },
          "display": { "$ref": "#/$defs/display" },
          "contentRect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "width": { "type": "integer", "minimum": 2 },
              "height": { "type": "integer", "minimum": 2 }
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display"
      ],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "type": "string",
          "minLength": 1
        },
        "mic": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stop": {
      "description": "Present after a clean stop. t is session-relative ns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "reason"
      ],
      "properties": {
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "user",
                "display-reconfigured",
                "stream-stopped",
                "stopped-during-start",
                "window-resized",
                "window-closed",
                "region-out-of-bounds",
                "device-lost",
                "error",
                "quit",
                "stdin-closed",
                "user-timeout",
                "display-reconfigured-timeout",
                "stream-stopped-timeout",
                "stopped-during-start-timeout",
                "window-resized-timeout",
                "window-closed-timeout",
                "region-out-of-bounds-timeout",
                "device-lost-timeout",
                "error-timeout",
                "quit-timeout",
                "stdin-closed-timeout"
              ]
            },
            {
              "pattern": "^signal-[0-9]+(-timeout)?$"
            }
          ],
          "description": "Why the recording ended, as the helper writes it. Same families anchors-2 describes, plus 'window-resized'/'window-closed' (STC-370) and 'region-out-of-bounds' (STC-235): a region-scope take whose refit left the region entirely off every display ends the same clean way a display reconfiguration does. A '-timeout' suffix on ANY of them means the writer did not finalise in time and the sidecars were written anyway. helper/test/stop-reasons.test.ts holds this schema to the reasons the Swift can actually produce."
        }
      }
    }
  }
}
